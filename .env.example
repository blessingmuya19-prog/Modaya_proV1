# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── AI (optional) ─────────────────────────────────────────────────────────────
# The editor works with none of these set: it falls back to a deterministic
# rules engine. Add ONE free key to turn on real language understanding.
# Providers are tried in the order below; set LLM_PROVIDER to force one.

# Groq — free tier, no credit card, OpenAI-compatible, very fast
# https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio — free Flash models
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — several models with a :free suffix
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI — free daily allowance
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Ollama — a model running on your own machine, fully offline
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional overrides
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b

# The model used when frames are attached — it must accept images.
# Groq: qwen/qwen3.6-27b   Gemini: any Flash   OpenRouter: google/gemma-4-31b-it:free
# LLM_VISION_MODEL=qwen/qwen3.6-27b
# OLLAMA_VISION_MODEL=llava
