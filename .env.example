# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ── AI (optional) ─────────────────────────────────────────────────────────────
# The editor works with none of these set: it falls back to a deterministic
# rules engine. Add ONE free key to turn on real language understanding.
# Providers are tried in the order below; set LLM_PROVIDER to force one.

# Groq — free tier, no credit card, OpenAI-compatible, very fast.
# THIS IS THE ONE KEY TO ADD: a single Groq key powers both the AI editing
# brain AND automatic captions/speech-to-text (Whisper large-v3-turbo runs on
# Groq's free tier). Get it at https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio — free Flash models
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — several models with a :free suffix
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cloudflare Workers AI — free daily allowance
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Ollama — a model running on your own machine, fully offline
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional overrides
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b

# The model used when frames are attached — it must accept images.
# Groq: qwen/qwen3.6-27b   Gemini: any Flash   OpenRouter: google/gemma-4-31b-it:free
# LLM_VISION_MODEL=qwen/qwen3.6-27b
# OLLAMA_VISION_MODEL=llava

# ── Durable media storage (optional) ──────────────────────────────────────────
# Footage normally lives in the browser (IndexedDB). Set durable storage so
# projects reopen on any device and the visual ranker can fetch the footage.
#
# Nothing to set for local dev or a self-hosted server with a writable disk:
# files are stored under DATA_DIR (default ./data/media) automatically.
# DATA_DIR=/var/lib/modaya
# STORAGE_DRIVER=fs        # force local disk | mem (in-process, serverless)
# MEDIA_MAX_UPLOAD_MB=2000
#
# Cloud object storage — any S3-compatible service (Cloudflare R2, AWS S3,
# MinIO, Backblaze B2). Signed with SigV4, no SDK needed. R2 example:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=modaya
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto           # "auto" for R2, e.g. "us-east-1" for AWS
# S3_PREFIX=media
#
# Public origin of this deployment — required to hand external services a
# reachable URL to stored footage (e.g. the TwelveLabs ranker).
# PUBLIC_BASE_URL=https://modaya.example.com
# SIGNED_MEDIA_SECRET=     # defaults to JWT_SECRET; set separately in production

# ── TwelveLabs Pegasus visual ranker (optional) ──────────────────────────────
# Ranks clip-worthy moments from the actual frames+audio (free tier at
# https://platform.twelvelabs.io). Never blocks clips when unconfigured.
# With durable storage + PUBLIC_BASE_URL set above, the footage is handed to
# Pegasus automatically; otherwise set a direct public video URL here.
# TWELVELABS_API_KEY=
# TWELVELABS_MODEL=pegasus1.5
# TWELVELABS_URL=          # fallback public video URL
